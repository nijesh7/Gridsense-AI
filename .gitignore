!.env.example
!server/.env.example
!client/.env.example

# Firebase Logs & Runtime Cache
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Editor & OS Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

