.installed.cfg
*.egg

# Large Generated Datasets
*.csv
!*.sample.csv

# Environment Secrets & Private Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env
firebase-adminsdk*.json
serviceAccountKey.json

