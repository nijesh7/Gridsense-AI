rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * GridSense AI - Firestore Security Rules
     * Project: gridsense-4b9d8
     *
     * DEVELOPMENT / DEMO MODE (Active):
     * Allows seamless read and write access for local dashboard telemetry,
     * live alerts onSnapshot listeners, and simulation logs.
     */
    match /{document=**} {
      allow read, write: if true;
    }

    /**
     * PRODUCTION RBAC RULES (Uncomment when Firebase Authentication & Custom Claims are enabled)
     *
     * function isAuthenticated() {
     *   return request.auth != null;
     * }
     * function getUserRole() {
     *   return request.auth.token.role;
     * }
     * function isAdmin() {
     *   return isAuthenticated() && (getUserRole() == 'ADMIN' || request.auth.token.email.matches('.*admin.*'));
     * }
     * function isDiscomOperator() {
     *   return isAuthenticated() && (getUserRole() == 'DISCOM_OPERATOR' || isAdmin());
     * }
     * function isCommunityManager() {
     *   return isAuthenticated() && (getUserRole() == 'COMMUNITY_MANAGER' || isAdmin());
     * }
     *
     * match /neighbourhoods/{neighbourhoodId} {
     *   allow read: if true;
     *   allow write: if isCommunityManager() || isDiscomOperator();
     * }
     * match /alerts/{alertId} {
     *   allow read: if true;
     *   allow write: if isDiscomOperator() || isCommunityManager();
     * }
     * match /simulationRuns/{runId} {
     *   allow read, write: if true;
     * }
     */
  }
}
